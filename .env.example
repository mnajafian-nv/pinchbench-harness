# NVIDIA Inference Hub API key (get one at https://build.nvidia.com/, starts with sk-)
NVIDIA_API_KEY=

# Optional overrides (defaults are relative to repo root)
# NEMOFLOW_DIR=./NeMo-Flow
# PHOENIX_VENV=./.venv
# GITLAB_REPO=https://gitlab-master.nvidia.com/nemo-agent-toolkit/dev/NeMo-Flow.git
# GITLAB_BRANCH=fix/openai-chat-optional-tool-fields
# OPENCLAW_BIN=$HOME/.local/bin/openclaw
#
# If HTTPS doesn't resolve (e.g., GPU cloud instances without internal DNS):
# GITLAB_REPO=ssh://git@gitlab-master.nvidia.com:12051/nemo-agent-toolkit/dev/NeMo-Flow.git
#
# If NeMo-Flow is already cloned elsewhere:
# NEMOFLOW_DIR=/ephemeral/NeMo-Flow
